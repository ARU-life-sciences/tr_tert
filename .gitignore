/outputs/logs
/inputs/extra_genomes/
__pycache__/
# regenerated scratch output of update_assembly_list.bash - stale as soon
# as the underlying assembly tree moves; the substance of any finding
# from these belongs in notes/, not a raw snapshot here.
/outputs/dtol_plant_paths.fresh.txt
/outputs/dtol_plant_paths.suspect_organelle.txt
# raw per-window tidk search dumps (tens of MB each) behind
# tr_repeat_correlation.md's confirmations - the meaningful summary is
# outputs/tr_repeat_correlation/positional_confirmations.tsv (tracked);
# regenerate the raw scans with src/confirm_repeat_positional.py if needed.
/outputs/tr_repeat_correlation/positional/
# blastn database files built by check_gene_synteny_gap.py - large (tens
# of MB) and trivially regenerable from the genome assembly; the
# meaningful output is the *_synteny_blastn.tsv hit table (tracked).
/outputs/synteny_checks/*_db.*
# clade_discovery/ (new-clade TR/TERT discovery, see clade_discovery/notes/plan.md)
/clade_discovery/outputs/logs
/clade_discovery/outputs/classify_genera.log
/clade_discovery/inputs/candidate_genera_ge2.txt
# raw per-window tidk search dumps behind positional_confirmations.tsv -
# confirm_repeat_positional_clade.py deletes these immediately after
# analysis (see its own comment for why), but ignore the pattern too in
# case one is ever regenerated by hand for inspection and left in place.
/clade_discovery/outputs/positional/*_telomeric_repeat_windows.tsv
# small per-run tidk search --log files (a few hundred bytes each, but
# one per species/candidate - clutter, not meaningful individually; the
# real result is outputs/positional_confirmations.tsv).
/clade_discovery/outputs/positional/*.log
# verbose cmsearch per-hit alignment output (MB-scale) - the structured
# .tbl file has everything downstream steps actually use.
/clade_discovery/outputs/snrna_search/*_snrna.log
# pinned tool binaries (e.g. bin/tidk-0.3.0 used by src/run_tidk_v03.bash)
/bin/
# tidk 0.3.0 rerun (notes/tidk_v03_rerun.md): per-candidate tidk ends runs
# are bulky (~40MB) and quick to regenerate with
# src/run_tidk_ends_candidates.bash; the chosen candidate per species is
# recorded in outputs/tidk_v0.3/summary.tsv. Per-job stderr logs likewise.
/outputs/tidk_ends/candidates/
/outputs/tidk_ends/*.err
/outputs/tidk_v0.3/*.err
# per-species walk inputs/results/logs behind the re-derived control group
# (src/run_identical_set_array_structure_bsub.bash); the merged
# identical_set_array_structure.tsv and its summary are what's tracked.
/outputs/tr_repeat_correlation/tidk_v03/**/per_species/
/outputs/tr_repeat_correlation/tidk_v03/**/inputs/
/outputs/tr_repeat_correlation/tidk_v03/**/logs/
/outputs/tr_repeat_correlation/tidk_v03/per_species/
/outputs/tr_repeat_correlation/tidk_v03/inputs/
/outputs/tr_repeat_correlation/tidk_v03/logs/
# clade_discovery tidk 0.3.0 rerun: same as the parent project's
/clade_discovery/outputs/tidk_ends/candidates/
/clade_discovery/outputs/tidk_ends/*.err
/clade_discovery/outputs/tidk_v0.3/*.err

